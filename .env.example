# Chatii Environment Configuration Template

# Runtime Environment (development, production, test)
CHATII_ENV=development

# Database Settings (PostgreSQL)
POSTGRES_USER=chatii_user
POSTGRES_PASSWORD=chatii_secure_password
POSTGRES_DB=chatii_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chatii_user:chatii_secure_password@localhost:5432/chatii_db

# Cache & Message Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Logging Configurations
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# LOG_FORMAT: JSON, CONSOLE
LOG_FORMAT=CONSOLE

# Directory Configuration
CONFIG_DIR=configs
DATA_DIR=datasets
MODEL_DIR=models
