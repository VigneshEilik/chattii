# Chatii Production Environment Settings
CHATII_ENV=production

# Database Settings (PostgreSQL - docker internal hosts)
POSTGRES_USER=chatii_prod_user
POSTGRES_PASSWORD=chatii_prod_secure_password_replace_me
POSTGRES_DB=chatii_prod
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chatii_prod_user:chatii_prod_secure_password_replace_me@db:5432/chatii_prod

# Cache & Message Queue (Redis - docker internal hosts)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Logging Configurations
LOG_LEVEL=INFO
LOG_FORMAT=JSON

# Directory Configuration
CONFIG_DIR=configs
DATA_DIR=datasets
MODEL_DIR=models
