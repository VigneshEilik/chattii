# Chatii Development Environment Settings
CHATII_ENV=development

# Database Settings (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatii_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatii_dev

# Cache & Message Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Logging Configurations
LOG_LEVEL=DEBUG
LOG_FORMAT=CONSOLE

# Directory Configuration
CONFIG_DIR=configs
DATA_DIR=datasets
MODEL_DIR=models
